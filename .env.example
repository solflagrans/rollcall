# Production: copy the pooled connection string from Neon.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32 (minimum 32 characters).
NEON_AUTH_COOKIE_SECRET=

# Local-only fallback. Keep false or omit in production.
DEMO_MODE=false
PGLITE_DATA_DIR=.data/rollcall
DEMO_AUTH_SECRET=

# Playwright
E2E_BASE_URL=http://127.0.0.1:3000
